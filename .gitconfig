[alias]
  aa = add .
  alias = !git config --list | grep 'alias\\.' | sed 's/alias\\.\\([^=]*\\)=\\(.*\\)/\\1\\\t   -- \\2/' | sort
  ap = add -p
  ba = branch -a
  bd = branch -d
  bdm = "!f(){ \
    out=$(git bm); \
    if [ -z \"$out\" ]; then return 0; fi; \
    echo \"$out\"; \
    printf 'Delete the branches listed above? [y/N] '; \
    ans=; read -r ans || ans=; \
    case \"$ans\" in y|Y) ;; *) echo 'aborted'; return 0;; esac; \
    mainwt=$(git worktree list --porcelain | sed -n '1s/^worktree //p'); \
    curwt=$(git rev-parse --show-toplevel); \
    git for-each-ref --merged HEAD --format='%(refname:short)%0a%(worktreepath)' refs/heads | { \
      rc=0; \
      while read -r b; do \
        read -r w; \
        if [ \"$w\" = \"$mainwt\" ] || [ \"$w\" = \"$curwt\" ]; then continue; fi; \
        if [ -n \"$w\" ]; then \
          if [ -n \"$(git -C \"$w\" status --porcelain)\" ]; then \
            echo \"skipped $b (worktree has local changes: $w)\"; \
            continue; \
          fi; \
          git worktree remove \"$w\" || { rc=1; continue; }; \
        fi; \
        git branch -d \"$b\" || rc=1; \
      done; \
      exit $rc; \
    }; \
  }; f"
  bm = "!f(){ \
    mainwt=$(git worktree list --porcelain | sed -n '1s/^worktree //p'); \
    curwt=$(git rev-parse --show-toplevel); \
    out=$(git for-each-ref --merged HEAD --format='%(refname:short)%0a%(worktreepath)' refs/heads | \
      while read -r b; do \
        read -r w; \
        if [ \"$w\" = \"$mainwt\" ] || [ \"$w\" = \"$curwt\" ]; then continue; fi; \
        if [ -z \"$w\" ]; then \
          echo \"  $b\"; \
        elif [ -z \"$(git -C \"$w\" status --porcelain)\" ]; then \
          echo \"  $b  (worktree: $w)\"; \
        else \
          echo \"  $b  [skip] worktree has local changes: $w\"; \
          git -C \"$w\" status --porcelain | sed 's/^/        /'; \
        fi; \
      done); \
    if [ -z \"$out\" ]; then echo 'no merged branches to clean up' >&2; return 0; fi; \
    echo 'merged branches:'; \
    echo \"$out\"; \
  }; f"
  branches = branch -a
  bv = branch -vv
  cm = commit
  cma = commit --amend
  cmm = commit -m
  co = checkout
  d = diff
  fp = fetch --prune
  ib = !([ ! -e .gitignore ] && touch .gitignore) | gibo dump $2 >> .gitignore
  ignore = !([ ! -e .gitignore ] && touch .gitignore) | echo $2 >> .gitignore
  l = log --stat --abbrev-commit -n 1
  la = log --graph --pretty='format:[%ad %C(yellow)%h%Creset] %s %C(green)<%an>%Creset %C(red)%d%Creset' --date=short
  ls = log --pretty='format:%C(yellow)%h%Creset %ad %s' --date=short --all
  nffmerge = merge --no-ff
  ps = push
  ra = remote add
  remotes = remote -v
  rename = branch -M
  revision = rev-parse HEAD
  rb = reset --soft HEAD^
  rr = !git rev-parse $(git log --oneline -n 1 . | awk '{{print $1}}')
  rv = remote -v
  sb = status --branch --short
  ss = status -s
  st = status
  stashes = stash list
  tags = tag
  uncommit = reset --mixed HEAD~
  unstage = reset -q HEAD --
  undo = "!f() { \\\n    git reset --hard $(git rev-parse --abbrev-ref HEAD)@{${1-1}}; \\\n}; f"
  wt = worktree
  wt-add = "!f(){ \
    if [ -z \"$1\" ]; then echo 'Usage: git wt-add <branch>' >&2; exit 1; fi; \
    branch=$1; \
    git_dir=$(git rev-parse --git-dir); \
    root=\"$git_dir/worktree\"; \
    path=\"$root/$branch\"; \
    mkdir -p \"$path\"; \
    git worktree add -b \"$branch\" \"$path\" HEAD 2>/dev/null || git worktree add \"$path\" \"$branch\"; \
  }; f"
[color]
  branch = auto
  diff = auto
  status = auto
  ui = auto
[merge "mergepbx"]
	name = Xcode project files merger
	driver = mergepbx %O %A %B
[push]
  default = simple
[diff]
	compactionHeuristic = true
[pager]
	log = $(brew --prefix)/share/git-core/contrib/diff-highlight/diff-highlight | less
	show = $(brew --prefix)/share/git-core/contrib/diff-highlight/diff-highlight | less
	diff = $(brew --prefix)/share/git-core/contrib/diff-highlight/diff-highlight | less
[ghq]
	root = ~/dev/src
[secrets]
	providers = git secrets --aws-provider
	patterns = [A-Z0-9]{20}
	patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
	patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
	allowed = AKIAIOSFODNN7EXAMPLE
	allowed = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
[init]
	defaultBranch = main
[user]
	name = 70_10
	email = 7010.dev@gmail.com
[include]
	path = ~/.gitconfig.local
